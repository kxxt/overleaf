OVERLEAF_APP_NAME=USTC Latex

#CASURL=https://passport.ustc.edu.cn/

DOCKER_RUNNER=true
TEXLIVE_IMAGE=texlive-full
TEXLIVE_IMAGE_USER=root
TEX_LIVE_DOCKER_IMAGE=texlive-full
ALL_TEX_LIVE_DOCKER_IMAGES=texlive-full,texlive-2019,texlive-2022,texlive-2023,texlive-2024
ALL_TEX_LIVE_DOCKER_IMAGE_NAMES=TeX Live 2025,TeX Live 2019,TeX Live 2022,TeX Live 2023,TeX Live 2024
ALLOWED_IMAGES=texlive-full texlive-2019 texlive-2022 texlive-2023 texlive-2024

SANDBOXED_COMPILES=true
SANDBOXED_COMPILES_SIBLING_CONTAINERS=true
SANDBOXED_COMPILES_HOST_DIR_COMPILES=/srv/toolkit/data/sharelatex/data/compiles
SANDBOXED_COMPILES_HOST_DIR_OUTPUT=/srv/toolkit/data/sharelatex/data/output

ENABLED_LINKED_FILE_TYPES=project_file,project_output_file

# Enables Thumbnail generation using ImageMagick
ENABLE_CONVERSIONS=true

# Disables email confirmation requirement
EMAIL_CONFIRMATION_DISABLED=true

# Required for sharing-link token generation. Generate a deployment-specific
# value with `openssl rand -base64 32`; do not commit the generated secret.
# OVERLEAF_INVITE_TOKEN_SECRET=

## Nginx
# NGINX_WORKER_PROCESSES=4
# NGINX_WORKER_CONNECTIONS=768

## Set for TLS via nginx-proxy
OVERLEAF_SECURE_COOKIE=true

OVERLEAF_SITE_URL=

OVERLEAF_NAV_TITLE=USTC Latex

# OVERLEAF_HEADER_IMAGE_URL=http://somewhere.com/mylogo.png

OVERLEAF_ADMIN_EMAIL=example@mail.com

# OVERLEAF_LEFT_FOOTER=[{"text":"Powered by Overleaf © 2021", "url": "https://www.overleaf.com"}, {"text": "Contact your support team", "url": "mailto:support@example.com"} ]
# OVERLEAF_RIGHT_FOOTER=[{"text":"Hello I am on the Right"}]

OVERLEAF_EMAIL_FROM_ADDRESS=example@mail.com
OVERLEAF_EMAIL_SMTP_HOST=smtp.exmail.qq.com
OVERLEAF_EMAIL_SMTP_PORT=465
OVERLEAF_EMAIL_SMTP_SECURE=true
OVERLEAF_EMAIL_SMTP_USER=example@mail.com
OVERLEAF_EMAIL_SMTP_PASS=
OVERLEAF_EMAIL_SMTP_NAME=example@mail.com

OVERLEAF_EMAIL_SMTP_TLS_REJECT_UNAUTH=true
OVERLEAF_EMAIL_SMTP_IGNORE_TLS=true
OVERLEAF_CUSTOM_EMAIL_FOOTER=

################
## Server Pro ##
################

EXTERNAL_AUTH=none
# OVERLEAF_LDAP_URL=ldap://ldap:389
# OVERLEAF_LDAP_SEARCH_BASE=ou=people,dc=planetexpress,dc=com
# OVERLEAF_LDAP_SEARCH_FILTER=(uid={{username}})
# OVERLEAF_LDAP_BIND_DN=cn=admin,dc=planetexpress,dc=com
# OVERLEAF_LDAP_BIND_CREDENTIALS=GoodNewsEveryone
# OVERLEAF_LDAP_EMAIL_ATT=mail
# OVERLEAF_LDAP_NAME_ATT=cn
# OVERLEAF_LDAP_LAST_NAME_ATT=sn
# OVERLEAF_LDAP_UPDATE_USER_DETAILS_ON_LOGIN=true

# OVERLEAF_TEMPLATES_USER_ID=578773160210479700917ee5
# OVERLEAF_NEW_PROJECT_TEMPLATE_LINKS=[{"name":"All Templates","url":"/templates/all"}]

OVERLEAF_PROXY_LEARN=true
